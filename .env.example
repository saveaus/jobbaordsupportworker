# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CONTACT_EMAIL=

# --- Supabase (staging and production are separate projects, Sydney region) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: used ONLY in webhooks, cron routes and admin actions.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used by migrations and the seed script.
SUPABASE_DB_URL=

# --- Stripe (test keys on staging, live on production) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Created by scripts/stripe-setup.ts: monthly and annual prices plus the 10% GST tax rate.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_TAX_RATE_GST=

# --- Resend ---
RESEND_API_KEY=
# Transactional subdomain (auth, notices): e.g. "Supportwork <no-reply@mail.example.com.au>"
EMAIL_FROM_TRANSACTIONAL=
# Alerts subdomain (job alerts, digests): e.g. "Supportwork <alerts@alerts.example.com.au>"
EMAIL_FROM_ALERTS=

# --- Cron ---
# Random secret; the daily cron route rejects requests without it.
CRON_SECRET=

# --- Cloudflare Turnstile (invisible) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
